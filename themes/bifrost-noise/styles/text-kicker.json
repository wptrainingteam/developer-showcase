{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/wp/trunk/schemas/json/theme.json",
	"version": 3,
	"title": "Kicker",
	"description": "Textual kicker.",
	"slug": "text-kicker",
	"blockTypes": [
		"core/heading",
		"core/paragraph"
	],
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--foreground-accent)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--mono)",
			"fontSize": "var(--wp--preset--font-size--2-xs)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--2-xs)",
			"textTransform": "uppercase"
		}
	}
}
