{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/wp/trunk/schemas/json/theme.json",
	"version": 3,
	"title": "Site Footer",
	"slug": "site-footer",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"css": "backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); position: relative;",
		"background": {
			"backgroundImage": "var(--wp--custom--image--noise)"
		},
		"border": {
			"top": {
				"color": "color-mix(in oklab, var(--wp--custom--color--neutral-200) 50%, transparent)",
				"style": "solid",
				"width": "1px"
			}
		},
		"color": {
			"background": "color-mix(in oklab, var(--wp--custom--color--neutral-50) 80%, transparent)",
			"text": "var(--wp--preset--color--foreground-default)"
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--sm)",
			"lineHeight": "var(--wp--preset-line-height--sm)"
		}
	}
}
