{
	"$schema": "https://raw.githubusercontent.com/WordPress/gutenberg/wp/trunk/schemas/json/theme.json",
	"version": 3,
	"title": "Style 3",
	"slug": "section-3",
	"blockTypes": [
		"core/column",
		"core/columns",
		"core/comment-content",
		"core/comment-template",
		"core/comments",
		"core/group",
		"core/media-text"
	],
	"styles": {
		"css": "backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);",
		"border": {
			"color": "color-mix(in oklab, var(--wp--custom--color--primary-200) 50%, transparent)",
			"style": "solid",
			"width": "1px"
		},
		"color": {
			"background": "color-mix(in oklab, var(--wp--custom--color--neutral-50) 80%, transparent)"
		},
		"spacing": {
			"padding": {
				"top": "1.5rem",
				"right": "1.5rem",
				"bottom": "1.5rem",
				"left": "1.5rem"
			}
		}
	}
}
