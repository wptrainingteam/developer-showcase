{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Polaroid",
	"slug": "image-polaroid",
	"blockTypes": [
		"core/image",
		"core/post-featured-image"
	],
	"styles": {
		"css": "box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.3); transform:rotate(3deg); transition:transform 0.3s ease; &:hover { transform:rotate(0deg); }",
		"color": {
			"gradient": "radial-gradient(ellipse at center, #ffffff 40%, #e5e5e5 70%, #d0d0d0 100%)"
		},
		"spacing": {
			"padding": {
				"top": "var(--wp--preset--spacing--10)",
				"right": "var(--wp--preset--spacing--10)",
				"bottom": "var(--wp--preset--spacing--90)",
				"left": "var(--wp--preset--spacing--10)"
			}
		}
	}
}
